# Kopieer naar .env en vul in
MINIFLUX_DB_PASSWORD=verander-mij
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=verander-mij-ook
MINIFLUX_BASE_URL=http://localhost:8081

# Maak na de eerste start in Miniflux aan: Instellingen > API-sleutels
MINIFLUX_API_KEY=

# Embeddings (meertalig, NL + EN). Verplicht.
EMBED_MODEL=bge-m3
# Optioneel: samenvattingen + "wat de bronnen bevestigen". Leeg = uit.
# Bijvoorbeeld qwen2.5:7b (CPU: traag maar werkt; GPU aanbevolen)
LLM_MODEL=

NTFY_TOPIC=nieuwsradar
NTFY_TOKEN=
NTFY_PUBLIC_URL=http://localhost:8082
NTFY_DEFAULT_ACCESS=read-write

# Adres waarop jij de PWA opent (wordt gebruikt als link in pushmeldingen)
RADAR_PUBLIC_URL=http://localhost:8080
